{
  "name": "@rub1cc/pi-sandbox",
  "version": "0.1.0",
  "description": "Codex-style permissions and OS-level sandboxing for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rub1cc/pi-sandbox.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "approvals.ts",
    "config.ts",
    "executor.ts",
    "modes.ts",
    "policy.ts",
    "reviewer.ts",
    "README.md"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "bun test",
    "test": "bun test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sandbox",
    "permissions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@rub1cc/pi-renderer": "0.1.0"
  },
  "bundledDependencies": [
    "@rub1cc/pi-renderer"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
